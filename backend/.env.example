# Copy to backend/.env (git-ignored). Never commit real keys; Cloud Run reads them from Secret Manager.
GEMINI_API_KEY=
# Several keys, tried in order when one is busy or out of quota (yours, then your wife's).
# One key per Google account: stacking projects on one account breaks the Gemini API terms.
# GEMINI_API_KEYS=key-one,key-two
# Tried in order when one is busy or out of its daily quota (P0-07 pick).
# GEMINI_MODELS=gemini-3.6-flash,gemini-3.8-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
# Local tests only: accept "Authorization: Bearer dev" as uid "dev". Never with a phone or tunnel.
# AUTH_MODE=dev
# Spark plan (P1-03): results in Firestore, videos on this PC. Needs: gcloud auth application-default login
USE_FIRESTORE=1
GOOGLE_CLOUD_PROJECT=reelbrain-dev
GOOGLE_CLOUD_QUOTA_PROJECT=reelbrain-dev
# PUBLIC_URL=http://127.0.0.1:8000
# Cloud (P0-05) only:
# GCS_BUCKET=reelbrain-dev.firebasestorage.app
# TASKS_QUEUE=projects/reelbrain-dev/locations/europe-west1/queues/process
# TASKS_SERVICE_ACCOUNT=reelbrain-api@reelbrain-dev.iam.gserviceaccount.com
# TASKS_AUDIENCE=https://<cloud-run-url>
