# Copy to /etc/reelbrain/env on the VM (root-only: chmod 600). Never commit the real file.
GEMINI_API_KEY=
# Or several, each from its own Google account: GEMINI_API_KEYS=key1,key2
PUBLIC_URL=https://realbrain-mahmoud.duckdns.org
USE_FIRESTORE=1
GOOGLE_CLOUD_PROJECT=reelbrain-dev
GOOGLE_APPLICATION_CREDENTIALS=/secrets/sa.json
DATA_DIR=/srv/data
TZ=Africa/Cairo
