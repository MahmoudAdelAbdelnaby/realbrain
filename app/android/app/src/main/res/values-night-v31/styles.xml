<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ splash: ink ground, the polygonal brain drawing itself once (docs/DESIGN_V4_PROPOSAL.md). -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowSplashScreenBackground">#0E0F12</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenAnimationDuration">800</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/ink</item>
    </style>
</resources>
