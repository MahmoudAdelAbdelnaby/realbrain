<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ splash: ink ground, the Glow mark animating once (docs/BRAND.md). -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowSplashScreenBackground">#0D1214</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenAnimationDuration">800</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/ink</item>
    </style>
</resources>
